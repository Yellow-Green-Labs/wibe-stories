# Internal logs folder — team-only source files are git-ignored.
# observer.js is un-ignored so it ships with the public site.
# Note: must use `*` not `/` here — a directory-level ignore prevents
# the `!` re-include rule from working (per Git docs).
internal-logs/*
!internal-logs/observer.js

# Internal documentation files — local-only references for developers
api/api-INTERNAL-DOC.md
global/global-INTERNAL-DOC.md
lib/lib-INTERNAL-DOC.md
scripts/scripts-INTERNAL-DOC.md

.env*.local

# VitePress build output (rebuilt on Vercel deploy)
docs-src/.vitepress/.temp/
docs-src/.vitepress/cache/
docs-src/.vitepress/dist/
blog-src/.vitepress/.temp/
blog-src/.vitepress/cache/
blog-src/.vitepress/dist/

# Root public/ — likely a VitePress build artifact at project root
/public/

# Teaching workspace — lessons, learning records, reference materials
/teaching/

# Local demo/marketing videos — hosted on Cloudflare R2, never committed
assets/cards/*.webm
assets/cards/*.mp4
assets/cards/*.gif
assets/featurepage/hero-video/
