{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Wibe Stories",
  "colors": {
    "primary": "#ffa946",
    "light": "#fffffe",
    "dark": "#1a1a1a"
  },
  "navigation": {
    "groups": [
      {
        "group": "Home",
        "pages": ["README"]
      },
      {
        "group": "Product",
        "pages": ["docs/WIBE_STORIES", "docs/ROADMAP"]
      },
      {
        "group": "Trust",
        "pages": ["docs/TRUST_CENTER"]
      },
      {
        "group": "Transparency",
        "pages": ["docs/ACKNOWLEDGEMENTS", "docs/LIMITATIONS"]
      },
      {
        "group": "History",
        "pages": ["CHANGELOG"]
      }
    ],
    "anchors": [
      {
        "anchor": "Legal",
        "icon": "scale",
        "href": "https://wibestories.vercel.app/legal"
      }
    ]
  },
  "logo": {
    "light": "/images/ws-logo-blwbg.png",
    "dark": "/images/ws-logo-whblbg.png"
  },
  "favicon": {
    "light": "/images/ws-logo-blwbg.png",
    "dark": "/images/ws-logo-whblbg.png"
  },
  "background": {
    "color": {
      "light": "#ffffeb",
      "dark": "#1a1a1a"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "navbar": {
    "links": []
  },
  "fonts": {
    "heading": {
      "family": "Inter"
    },
    "body": {
      "family": "Roboto"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "variables": {
    ".copy": "© 2026 YGLabs",
    ".ws": "Wibe Stories"
  },
  "description": "Turn your voice into shareable cards, in your language, in seconds."
}
