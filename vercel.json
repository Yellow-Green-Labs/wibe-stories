{
  "buildCommand": "node scripts/fetch-content.mjs && npx vitepress build blog-src && npx pagefind --site blog-src/.vitepress/dist && node scripts/copy-fontawesome.mjs && node scripts/gen-sitemap.mjs && npx vitepress build docs-src",
  "outputDirectory": ".",
"rewrites": [
    { "source": "/__clerk/:path*", "destination": "/api/clerk-proxy?clerkPath=:path*" },
    { "source": "/", "destination": "/wisprstories.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/language-stats", "destination": "/language-stats.html" },
    { "source": "/card", "destination": "/wisprstories.html" },
    { "source": "/c/:id", "destination": "/api/c/[id]" },
    { "source": "/download/:id", "destination": "/api/download/:id" },
    { "source": "/docs", "destination": "/docs-src/.vitepress/dist/index.html" },
    { "source": "/docs/", "destination": "/docs-src/.vitepress/dist/index.html" },
    { "source": "/docs/assets/:path*", "destination": "/docs-src/.vitepress/dist/assets/:path*" },
    { "source": "/docs/vp-icons.css", "destination": "/docs-src/.vitepress/dist/vp-icons.css" },
    { "source": "/docs/hashmap.json", "destination": "/docs-src/.vitepress/dist/hashmap.json" },
    { "source": "/docs/404", "destination": "/docs-src/.vitepress/dist/404.html" },
    { "source": "/docs/:path*.html", "destination": "/docs/:path*", "statusCode": 301 },
    { "source": "/docs/:path*/", "destination": "/docs-src/.vitepress/dist/:path*.html" },
    { "source": "/docs/:path*", "destination": "/docs-src/.vitepress/dist/:path*.html" },
    { "source": "/blog", "destination": "/blog-src/.vitepress/dist/index.html" },
    { "source": "/blog/", "destination": "/blog-src/.vitepress/dist/index.html" },
    { "source": "/blog/assets/:path*", "destination": "/blog-src/.vitepress/dist/assets/:path*" },
    { "source": "/blog/hashmap.json", "destination": "/blog-src/.vitepress/dist/hashmap.json" },
    { "source": "/blog/vp-icons.css", "destination": "/blog-src/.vitepress/dist/vp-icons.css" },
    { "source": "/blog/BLOG-LOGO.png", "destination": "/blog-src/.vitepress/dist/BLOG-LOGO.png" },
    { "source": "/blog/BLOG-LABEL.png", "destination": "/blog-src/.vitepress/dist/BLOG-LABEL.png" },
    { "source": "/blog/WS-HORI-DARK.png", "destination": "/blog-src/.vitepress/dist/WS-HORI-DARK.png" },
    { "source": "/blog/WS-HORI-LIGHT.png", "destination": "/blog-src/.vitepress/dist/WS-HORI-LIGHT.png" },
    { "source": "/blog/ws-l-b.ico", "destination": "/blog-src/.vitepress/dist/ws-l-b.ico" },
    { "source": "/blog/sitemap.xml", "destination": "/blog-src/.vitepress/dist/sitemap.xml" },
    { "source": "/blog/pagefind/:path*", "destination": "/blog-src/.vitepress/dist/pagefind/:path*" },
    { "source": "/blog/404", "destination": "/404.html" },
    { "source": "/blog/:locale", "destination": "/blog-src/.vitepress/dist/:locale/index.html" },
    { "source": "/blog/:locale/", "destination": "/blog-src/.vitepress/dist/:locale/index.html" },
    { "source": "/blog/:path*.html", "destination": "/blog/:path*", "statusCode": 301 },
    { "source": "/blog/:path*/", "destination": "/blog-src/.vitepress/dist/:path*.html" },
    { "source": "/blog/:path*", "destination": "/blog-src/.vitepress/dist/:path*.html" }
  ],
  "redirects": [
    { "source": "/about.html", "destination": "/about", "statusCode": 301 },
    { "source": "/pricing.html", "destination": "/pricing", "statusCode": 301 },
    { "source": "/language-stats.html", "destination": "/language-stats", "statusCode": 301 },
    { "source": "/legal", "destination": "/docs/legal/license", "statusCode": 301 },
    { "source": "/legal/:path*", "destination": "/docs/legal/:path*", "statusCode": 301 },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "wisprstories.vercel.app" }], "destination": "https://wibestories.vercel.app/$1", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
         { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://analytics.ahrefs.com https://*.clerk.accounts.dev https://*.clerk.com https://challenges.cloudflare.com https://*.protect.clerk.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.blob.vercel-storage.com https://*.public.blob.vercel-storage.com https://cdn.simpleicons.org https://picsum.photos https://fastly.picsum.photos https://img.clerk.com https://*.r2.dev; media-src 'self' blob: https://*.public.blob.vercel-storage.com https://*.r2.dev; connect-src 'self' https://unpkg.com https://cdn.jsdelivr.net https://fonts.googleapis.com https://fonts.gstatic.com https://*.public.blob.vercel-storage.com https://*.sentry.io https://analytics.ahrefs.com https://*.up.railway.app https://*.clerk.accounts.dev https://clerk.accounts.dev https://*.protect.clerk.com:*; frame-src https://*.clerk.accounts.dev https://*.clerk.com https://wibeandwonder.substack.com https://challenges.cloudflare.com https://*.protect.clerk.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none';" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), gyroscope=(), magnetometer=(), payment=(), usb=(), microphone=(self)" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
